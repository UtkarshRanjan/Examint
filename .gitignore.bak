# --- Next.js build output ---
.next/
out/

# --- Node.js ---
node_modules/

# --- Environment variables (NEVER commit these) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- SQLite database (contains all teacher data) ---
# BACK THIS UP: copy prisma/dev.db to a safe location regularly
prisma/*.db
prisma/*.db-journal

# --- Uploaded images (contains all teacher-uploaded content) ---
# BACK THIS UP: copy the entire uploads/ folder to a safe location regularly
uploads/

# --- OS / Editor artifacts ---
.DS_Store
Thumbs.db
*.pem

# --- Debug logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- TypeScript build info ---
*.tsbuildinfo
next-env.d.ts
