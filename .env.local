# ============================================================
# Examint — Environment Variables
# ============================================================
# IMPORTANT: Never commit this file to git. It is listed in .gitignore.

# --- Database ---
# Path to the SQLite database file managed by Prisma.
# The "file:./prisma/dev.db" path is relative to the project root.
DATABASE_URL="file:./prisma/dev.db"

# --- NextAuth.js ---
# Secret used to sign/encrypt session tokens AND to encrypt the Gemini API key
# stored in the User table. Generate a strong value with:
#   openssl rand -base64 32
# or on Windows PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
NEXTAUTH_SECRET="a3f9c2e87b14d056f8a21c3e9d7b4f0e2a1c8d5f3e7b9a2c4d6f8e1b3a5c7d9"

# The canonical URL of the application. Change to production URL when deploying.
NEXTAUTH_URL="http://localhost:3000"
